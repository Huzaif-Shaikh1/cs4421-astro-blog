---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
						<h1>👋 Hi, I'm Huzaif</h1>
			<p>
				I'm an Immersive Software Engineering (ISE) student at the University of Limerick, originally
				from Pakistan.
			</p>
			<p>
				Outside of coding, you'll usually find me on a pitch. I play soccer for the <strong>UL Wolves</strong>
   				freshers team and for <strong>Avenue United</strong> in Ennis.
			</p>
			<p>
				This site is also my CS4421 DevOps project. Every change I make is checked automatically by
				GitHub Actions and deployed to AWS, so what you're looking at was shipped through a real
				CI/CD pipeline.
			</p>
			<p>
				<a href="/soccer">Read about my soccer ⚽</a> · <a href="/about">About me</a> · <a href="/blog">Blog</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
